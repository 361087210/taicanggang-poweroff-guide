<?xml version='1.0' encoding='utf-8'?>
<widget id="com.taicanggang.poweroff" version="5.3.4" android-versionCode="50304" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>太仓港断电指导</name>
    <description>太仓港商品车断电操作标准化指导平台</description>
    <author email="dev@taicanggang.com" href="https://github.com/361087210/taicanggang-poweroff-guide">Taicanggang Dev Team</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="mailto:*" />
    <allow-navigation href="*" />
    <allow-navigation href="https://cdn.jsdelivr.net/*" />
    <allow-navigation href="https://cdn.tailwindcss.com/*" />

    <!-- Platform: Android -->
    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="34" />
        <preference name="AndroidXEnabled" value="true" />
        <preference name="android-edge-to-edge" value="true" />
        <preference name="StatusBarOverlaysWebView" value="false" />
        <preference name="StatusBarBackgroundColor" value="#1e3a5f" />
        <preference name="StatusBarStyle" value="darkcontent" />
        <preference name="DisallowOverscroll" value="true" />

        <!-- Camera permissions -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.CAMERA" />
            <uses-feature android:name="android.hardware.camera" android:required="false" />
            <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
        </config-file>

        <!-- Storage permissions: READ/WRITE_EXTERNAL_STORAGE由media-capture插件自动注入,此处仅声明插件未覆盖的媒体权限,避免Manifest合并冲突 -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
            <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
            <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
        </config-file>

        <!-- Network permissions -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
            <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
        </config-file>

    </platform>

    <!-- Cordova Plugins -->
    <plugin name="cordova-plugin-camera" />
    <plugin name="cordova-plugin-file" />
    <plugin name="cordova-plugin-media-capture" />
    <plugin name="cordova-plugin-statusbar" />
    <plugin name="cordova-plugin-edge-to-edge" />
    <!-- 原生社交分享: 调起系统分享面板,Word/PDF/Excel文件可分享到微信/QQ/钉钉等主流应用 -->
    <plugin name="cordova-plugin-x-socialsharing" />
    <!-- 原生HTTP(V5.3核心): 绕过WebView CORS限制,飞书API真机直连的唯一通道 -->
    <plugin name="cordova-plugin-advanced-http">
        <variable name="ANDROID_BLACKLIST_SECURE_PROTOCOL" value="false" />
    </plugin>

    <preference name="BackupStorage" value="none" />
    <preference name="SplashScreenDelay" value="1000" />
    <preference name="ShowSplashScreenSpinner" value="false" />
</widget>
