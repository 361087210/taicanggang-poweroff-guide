<?xml version='1.0' encoding='utf-8'?>
<widget id="com.taicanggang.poweroff" version="10.6.0" android-versionCode="100600" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>太仓港断电指导</name>
    <description>太仓港商品车断电操作标准化指导平台</description>
    <author email="dev@taicanggang.com" href="https://github.com/361087210/taicanggang-poweroff-guide">Taicanggang Dev Team</author>
    <content src="demo.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <platform name="android">
        <allow-intent href="market:*" />
        <preference name="AndroidXEnabled" value="true" />
        <preference name="GradlePluginKotlinEnabled" value="true" />
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="34" />
        <preference name="android-compileSdkVersion" value="34" />
        <preference name="AndroidPersistentFileLocation" value="Compatibility" />
        <preference name="AndroidInsecureFileModeEnabled" value="true" />
        <preference name="loadUrlTimeoutValue" value="60000" />
        <preference name="android-windowSoftInputMode" value="adjustResize" />
        <preference name="SplashScreenDelay" value="0" />
        <preference name="FadeSplashScreen" value="false" />
        <preference name="ShowSplashScreen" value="false" />
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="true" android:requestLegacyExternalStorage="true" android:allowBackup="false" />
        </edit-config>
        <config-file parent="/*" target="AndroidManifest.xml">
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
            <uses-permission android:name="android.permission.CAMERA" />
            <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
            <!-- V10.5.0: WRITE权限maxSdkVersion 28→29——Android 10(API29)在requestLegacyExternalStorage
             下走legacy存储模型,保存到公共Download仍需此运行时权限声明(11+ Scoped Storage免权限) -->
<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
            <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
            <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
            <uses-permission android:name="android.permission.WAKE_LOCK" />
            <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
            <uses-permission android:name="android.permission.VIBRATE" />
            <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
            <uses-feature android:name="android.hardware.camera" android:required="false" />
            <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
            <uses-feature android:name="android.hardware.location" android:required="false" />
            <!-- V5.7.1: 移除本行——geolocation插件会再声明一次location.gps, 双重声明
                 属性不一致(required)导致AGP8 Manifest merger崩溃; 统一由插件的GPS_REQUIRED=false提供 -->
        </config-file>
        <config-file parent="/manifest/application" target="AndroidManifest.xml">
            <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.fileprovider" android:exported="false" android:grantUriPermissions="true">
                <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
            </provider>
        </config-file>
    </platform>
    <plugin name="cordova-plugin-whitelist" spec="1.3.5" />
    <plugin name="cordova-plugin-device" spec="3.0.0" />
    <plugin name="cordova-plugin-network-information" spec="3.0.0" />
    <plugin name="cordova-plugin-dialogs" spec="2.0.2" />
    <plugin name="cordova-plugin-inappbrowser" spec="6.0.0" />
    <plugin name="cordova-plugin-file" spec="8.1.0" />
    <plugin name="cordova-plugin-file-transfer" spec="2.0.0" />
    <plugin name="cordova-plugin-camera" spec="7.0.0">
        <variable name="ANDROIDX_CORE_VERSION" value="1.8.+" />
    </plugin>
    <plugin name="cordova-plugin-media-capture" spec="5.0.0" />
    <plugin name="cordova-plugin-geolocation" spec="5.0.0">
        <variable name="GPS_REQUIRED" value="false" />
    </plugin>
    <plugin name="cordova-plugin-advanced-http" spec="3.3.1" />
    <plugin name="cordova-plugin-x-socialsharing" spec="6.0.4" />
    <!-- V5.7.1: 移除 cordova-plugin-qrscanner —— APP从未使用扫码功能, 且其qrscanner.gradle
         使用AGP8已删除的compile配置+jcenter()已关停, 是v5.4以来构建崩溃的元凶之一 -->
    <plugin name="cordova-plugin-screen-orientation" spec="3.0.3" />
    <plugin name="cordova-plugin-statusbar" spec="4.0.0" />
    <plugin name="cordova-plugin-splashscreen" spec="6.0.2" />
    <plugin name="cordova-plugin-app-version" spec="0.1.14" />
    <plugin name="cordova-plugin-android-permissions" spec="1.1.5" />
    <plugin name="cordova-plugin-local-notification" spec="1.2.3" />
    <plugin name="cordova-plugin-file-opener2" spec="4.0.0" />
    <hook type="after_prepare" src="scripts/patch_projectbuilder.js" />
</widget>